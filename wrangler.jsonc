// Cloudflare deploys the web app as a Worker: web/dist as static assets, and
// web/worker/index.js for /api/ (the sync store, a Durable Object per sync
// code). Its build runs `cd web && npm ci && npm run build`, then
// `npx wrangler deploy` from the repo root, which reads this file. See
// docs/hosting-the-web-app.md.
{
  "name": "skybother",
  "main": "./web/worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SYNC", "class_name": "SyncStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncStore"] }],
  // Per-address request limits for /api/ (see limited() in the Worker).
  // namespace_id is any number unique within the account.
  "ratelimits": [
    { "name": "SYNC_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "METNO_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "WORLDCOVER_LIMIT", "namespace_id": "1003", "simple": { "limit": 1000, "period": 60 } }
  ]
}
